@model UI.Models.WorldCupViewModel
@{
    ViewData["Title"] = "World Cup Results";
}

<h1>World Cup results</h1>

<form method="get" asp-controller="WorldCup" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label" for="year">Year</label>
        <input class="form-control" type="number" id="year" name="year" value="@Model.Year" min="1930" />
    </div>
    <div class="col-auto">
        <label class="form-label" for="team">Team</label>
        <input class="form-control" type="text" id="team" name="team" value="@Model.Team" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Search</button>
        <a class="btn btn-outline-secondary" asp-controller="WorldCup" asp-action="Index">Clear</a>
    </div>
</form>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@if (Model.Matches.Count == 0 && ViewData.ModelState.IsValid)
{
    <p>No matches found.</p>
}
else if (Model.Matches.Count > 0)
{
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th>Date</th>
                <th>Home</th>
                <th class="text-center">Score</th>
                <th>Away</th>
                <th>City</th>
                <th>Country</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var match in Model.Matches)
            {
                <tr>
                    <td>@match.Date.ToString("yyyy-MM-dd")</td>
                    <td>@match.HomeTeam</td>
                    <td class="text-center">@match.HomeScore - @match.AwayScore</td>
                    <td>@match.AwayTeam</td>
                    <td>@match.City</td>
                    <td>@match.Country</td>
                </tr>
            }
        </tbody>
    </table>
}
